PORT=8000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME= agenda

OPENROUTER_API_KEY=

# Modelo compacto, com boa qualidade para resumos curtos.
OPENROUTER_MODEL=openai/gpt-4.1-mini
# "latency" prioriza a menor latência. Use "price" se o menor custo for prioritário.
OPENROUTER_PROVIDER_SORT=latency
# Limites menores evitam respostas longas e lentas para esta tarefa.
OPENROUTER_MAX_COMPLETION_TOKENS=180
OPENROUTER_TIMEOUT_MS=12000
# A agenda faz parte da chave do cache; alterações geram uma nova entrada automaticamente.
OPENROUTER_CACHE_TTL_SECONDS=86400
OPENROUTER_LOCAL_CACHE_ENTRIES=300
